  "config.nekomasfixed.note.enchantments": "Each switch turns off what the enchantment does. The enchantment itself always exists, so an enchanted book or tool keeps its name and levels either way.",

  "config.nekomasfixed.netherFoodRotting.label": "Do Food Rotting",
  "config.nekomasfixed.netherFoodRotting.tooltip.0": "All food items except for the golden ones rot in nether over time",
  "config.nekomasfixed.magmaBreaksToLava.label": "Magma Breaks To Lava",
  "config.nekomasfixed.magmaBreaksToLava.tooltip.0": "Breaking a magma block without Silk Touch can turn it into lava",

  "config.nekomasfixed.enableCopperBuff.label": "Enable Copper Buffs",
  "config.nekomasfixed.enableCopperBuff.tooltip.0": "Lightning striking a player with full copper gear would give the player speed ",
  "config.nekomasfixed.clamGeneration.label": "Clam Generation",
  "config.nekomasfixed.clamGeneration.tooltip.0": "Scatter clams across ocean floors and coral reefs as the world generates",
  "config.nekomasfixed.geyserGeneration.label": "Geyser Generation",
  "config.nekomasfixed.geyserGeneration.tooltip.0": "Let geysers generate in the biomes they belong to",
  "config.nekomasfixed.termiteMoundGeneration.label": "Termite Mound Generation",
  "config.nekomasfixed.termiteMoundGeneration.tooltip.0": "Let termite mounds, with their hive and resident termites, generate in savanna and desert",
  "config.nekomasfixed.naturalMobSpawns.label": "Natural Mob Spawns",
  "config.nekomasfixed.naturalMobSpawns.tooltip.0": "Let this mod's mobs spawn on their own in the biomes they belong to",
  "config.nekomasfixed.naturalMobSpawns.tooltip.1": "Spawn eggs and the /summon command still work with this off",

  "config.nekomasfixed.sickleCombo.label": "Sickle Combo",
  "config.nekomasfixed.sickleCombo.tooltip.0": "Consecutive hits with a sickle build a combo that raises the damage of the next one",
  "config.nekomasfixed.offhandAttack.label": "Off-Hand Attacking",
  "config.nekomasfixed.offhandAttack.tooltip.0": "Attack with the weapon in your off hand as well as the one in your main hand",
  "config.nekomasfixed.featherKnockback.label": "Feather Knockback",
  "config.nekomasfixed.featherKnockback.tooltip.0": "Hitting a mob with a feather deals no damage but still knocks it back",
  "config.nekomasfixed.turtleArmourAbilities.label": "Turtle Armour Abilities",
  "config.nekomasfixed.turtleArmourAbilities.tooltip.0": "No fall damage into water in the flippers, faster mining while standing still in the",
  "config.nekomasfixed.turtleArmourAbilities.tooltip.1": "knee pads, and a damage guard while asleep in the shell",
  "config.nekomasfixed.wildfireShieldBlocking.label": "Wildfire Shield Blocking",
  "config.nekomasfixed.wildfireShieldBlocking.tooltip.0": "The wildfire shield soaks far more of a blocked hit than an ordinary shield does",
  "config.nekomasfixed.explosionResistantTemplates.label": "Explosion-Resistant Templates",
  "config.nekomasfixed.explosionResistantTemplates.tooltip.0": "Smithing templates survive fire and explosions instead of burning up with the rest",
  "config.nekomasfixed.explosionResistantTemplates.tooltip.1": "of the drops",
  "config.nekomasfixed.wideEnchantmentTargets.label": "Wide Enchantment Targets",
  "config.nekomasfixed.wideEnchantmentTargets.tooltip.0": "Offer enchantments the game normally restricts - sweeping, multishot, power and",
  "config.nekomasfixed.wideEnchantmentTargets.tooltip.1": "punch - on this mod's weapons",
  "config.nekomasfixed.targetDummyResistsExplosions.label": "Target Dummy Resists Explosions",
  "config.nekomasfixed.targetDummyResistsExplosions.tooltip.0": "A target dummy stays planted when something explodes beside it, so its damage",
  "config.nekomasfixed.targetDummyResistsExplosions.tooltip.1": "readout can still be read afterwards",
  "config.nekomasfixed.targetDummyCountsAsUndead.label": "Target Dummy Counts As Undead",
  "config.nekomasfixed.targetDummyCountsAsUndead.tooltip.0": "A dummy built on the zombie pattern counts as undead, so Smite and Bane of",
  "config.nekomasfixed.targetDummyCountsAsUndead.tooltip.1": "Arthropods add their bonus to the readout",
  "config.nekomasfixed.wildfireBombArc.label": "Wildfire Bomb Arc",
  "config.nekomasfixed.wildfireBombArc.tooltip.0": "The wildfire lobs its fire bombs along an arc worked out for how slowly they fall,",
  "config.nekomasfixed.wildfireBombArc.tooltip.1": "rather than one that assumes an ordinary thrown item",

  "config.nekomasfixed.dismount.label": "Dismount",
  "config.nekomasfixed.dismount.tooltip.0": "A hit throws the target off whatever it is riding, and shakes off anything riding",
  "config.nekomasfixed.dismount.tooltip.1": "the target as well",
  "config.nekomasfixed.leeching.label": "Leeching",
  "config.nekomasfixed.leeching.tooltip.0": "Heals whoever swung the weapon for a small share of the damage the hit dealt,",
  "config.nekomasfixed.leeching.tooltip.1": "more of it at higher levels",
  "config.nekomasfixed.shatter.label": "Shatter",
  "config.nekomasfixed.shatter.tooltip.0": "A slingshot shot bursts into five more on impact, ricocheting off whatever it struck",

  "config.nekomasfixed.messyBeds.label": "Messy Beds",
  "config.nekomasfixed.messyBeds.tooltip.0": "Beds are left unmade after sleeping, and villagers will not claim one until it has",
  "config.nekomasfixed.messyBeds.tooltip.1": "been made again with an empty hand",
  "config.nekomasfixed.featherFallingSavesCrops.label": "Feather Falling Saves Crops",
  "config.nekomasfixed.featherFallingSavesCrops.tooltip.0": "Boots enchanted with Feather Falling stop you trampling farmland",
  "config.nekomasfixed.dolphinsSeekCoralReefs.label": "Dolphins Seek Coral Reefs",
  "config.nekomasfixed.dolphinsSeekCoralReefs.tooltip.0": "Feed a dolphin a tropical fish and it leads you to a coral reef instead of a wreck",
  "config.nekomasfixed.beesPollinateMooblooms.label": "Bees Pollinate Mooblooms",
  "config.nekomasfixed.beesPollinateMooblooms.tooltip.0": "Bees visit mooblooms and gather nectar from the flower on their back",
  "config.nekomasfixed.foxesUsePotions.label": "Foxes Use Potions",
  "config.nekomasfixed.foxesUsePotions.tooltip.0": "A fox carrying a potion gets the effects of whatever it is holding",
  "config.nekomasfixed.snifferFindsModSeeds.label": "Sniffers Find This Mod's Seeds",
  "config.nekomasfixed.snifferFindsModSeeds.tooltip.0": "Sniffers turn up this mod's seeds alongside the torchflower and pitcher pods",
  "config.nekomasfixed.redstoneStriker.label": "Redstone Striker",
  "config.nekomasfixed.redstoneStriker.tooltip.0": "The redstone striker charges dust and components for a few ticks before the charge",
  "config.nekomasfixed.redstoneStriker.tooltip.1": "decays away again",
  "config.nekomasfixed.lightningInABottle.label": "Lightning In A Bottle",
  "config.nekomasfixed.lightningInABottle.tooltip.0": "A brewing stand under a lightning rod catches a strike as Lightning In A Bottle,",
  "config.nekomasfixed.lightningInABottle.tooltip.1": "which calls lightning down on whatever it is used on",

  "config.nekomasfixed.floatingDamageNumbers.label": "Floating Damage Numbers",
  "config.nekomasfixed.floatingDamageNumbers.tooltip.0": "Show the damage you deal as a number floating away from whatever you hit",
  "config.nekomasfixed.containerGridTooltips.label": "Container Grid Tooltips",
  "config.nekomasfixed.containerGridTooltips.tooltip.0": "Show a shulker box or bundle's contents as a grid of items in its tooltip instead",
  "config.nekomasfixed.containerGridTooltips.tooltip.1": "of a plain count",
  "config.nekomasfixed.comboDamageTooltip.label": "Combo Damage Tooltip",
  "config.nekomasfixed.comboDamageTooltip.tooltip.0": "Show the combo a sickle has built up as a line on its tooltip",
  "config.nekomasfixed.customMinecartModel.label": "Custom Minecart Model",
  "config.nekomasfixed.customMinecartModel.tooltip.0": "Draw minecarts with this mod's model instead of the plain one",

  "config.nekomasfixed.harnesses.label": "Harnesses",
  "config.nekomasfixed.harnesses.tooltip.0": "Let the four ancient-dye harnesses be worn by a happy ghast",
  "config.nekomasfixed.harnessRendering.label": "Harness Rendering",
  "config.nekomasfixed.harnessRendering.tooltip.0": "Draw this mod's harnesses on a happy ghast that is wearing one",
  "config.nekomasfixed.harnessRendering.tooltip.1": "Turn it off to leave the harness bare if a resource pack would rather supply that",
  "config.nekomasfixed.harnessRendering.tooltip.2": "artwork itself",
  "config.nekomasfixed.copperArmourSet.label": "Copper Armour Set",
  "config.nekomasfixed.copperArmourSet.tooltip.0": "Count a full copper armour set towards the copper lightning buff, alongside this",
  "config.nekomasfixed.copperArmourSet.tooltip.1": "mod's own copper crown and sickle",
  "config.nekomasfixed.eyeblossomMoobloom.label": "Eyeblossom Moobloom",
  "config.nekomasfixed.eyeblossomMoobloom.tooltip.0": "Add the open-eyeblossom moobloom, the fifteenth flower variant",
  "config.nekomasfixed.spearInteractions.label": "Spear Interactions",
  "config.nekomasfixed.spearInteractions.tooltip.0": "Treat backported spears as spears here - a dispenser stabs with one and pillagers",
  "config.nekomasfixed.spearInteractions.tooltip.1": "carry them on patrol",
  "config.nekomasfixed.backportedSlingshotAmmo.label": "Backported Slingshot Ammo",
  "config.nekomasfixed.backportedSlingshotAmmo.tooltip.0": "Allow copper nuggets and resin clumps as slingshot ammunition, each with its own",
  "config.nekomasfixed.backportedSlingshotAmmo.tooltip.1": "kind of shot",
  "config.nekomasfixed.maceInteractions.label": "Mace Interactions",
  "config.nekomasfixed.maceInteractions.tooltip.0": "Turtle headgear soaks a mace smash outright, taking the whole blow in durability",
  "config.nekomasfixed.maceInteractions.tooltip.1": "A smash is a mace swung while falling more than a block and a half",
  "config.nekomasfixed.trialSpawnersInFortressRooms.label": "Trial Spawners In Fortress Rooms",
  "config.nekomasfixed.trialSpawnersInFortressRooms.tooltip.0": "Put a trial spawner in the wildfire's Nether fortress room, which is otherwise built",
  "config.nekomasfixed.trialSpawnersInFortressRooms.tooltip.1": "empty",
  "config.nekomasfixed.breezeSounds.label": "Breeze Sounds",
  "config.nekomasfixed.breezeSounds.tooltip.0": "Give the wildfire a breeze's voice instead of the blaze sounds it falls back on",

